{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // Why oxlint and not ESLint: this project is on TypeScript 7, and
  // typescript-eslint refuses to load against it — see
  // https://github.com/typescript-eslint/typescript-eslint/issues/10940.
  // The alternatives were to pin TypeScript back to 6.x for the
  // linter's benefit, or to run a second TS copy side by side and lint
  // against a compiler the code isn't built with. oxlint parses TS
  // itself and needs no TypeScript API.
  //
  // Type-aware rules come from oxlint-tsgolint, which builds on the
  // Go port of tsc and so has no such version ceiling. `npm run lint`
  // passes --type-aware and is a hard gate: everything it reports is
  // an error, and the first run of it cleared 87 findings, including
  // humanizeError's own fallback rendering "[object Object]" into the
  // user's toast and a tsconfig option that TS 7 had removed.
  //
  // It needs the whole program, so it is slower than the parser-only
  // pass — seconds, not milliseconds. Run bare `oxlint` while editing
  // if that matters; CI and pre-commit run the type-aware one.

  "plugins": ["react", "typescript", "unicorn", "oxc"],

  // Only "correctness" is an error. Turning on `suspicious` and `perf`
  // as well produced over 4000 findings on first run, which is the
  // same as having no linter. This mirrors .golangci.yml's line:
  // catch real bugs, not style nits.
  "categories": { "correctness": "error" },

  "rules": {
    // Promoted to error: cheap to keep clean, and both were at zero
    // once the first pass was fixed.
    "eslint/no-unused-vars": "error",
    "eslint/no-unused-expressions": "error",

    // React 17+ automatic JSX transform — importing React is not
    // required and this rule fires ~4400 times if left on.
    "react/react-in-jsx-scope": "off",

    // Everything below is a pre-existing backlog, kept visible as
    // warnings rather than silenced. Warnings do not fail the run, so
    // `npm run lint` still gates on real violations; use
    // `--deny-warnings` to see the whole list as failures.
    //
    // set-state-in-effect started at 44 and is an error now. The ones
    // that remain each carry a comment naming the external system they
    // synchronise with — a timer, a poll, an IntersectionObserver, the
    // DOM, localStorage, a refcounted cache — which is the rule's own
    // criterion for when an effect is the right tool. Everything else
    // turned out to be a hand-rolled query, derived state, or one fact
    // split across two useStates.
    "react-hooks/exhaustive-deps": "warn",

    // Off, after reading all 44 it reported. The rule targets state
    // that should have been computed during render; exactly one of the
    // 44 was that (HostView's pickedSessionID, now derived — nothing
    // but its own effect ever wrote it, so every sessions update cost
    // a second render pass). The rest:
    //
    //   17  setLoading/setError before an async fetch
    //   14  `if (open) setX(...)` — reset a dialog's form on open
    //   10  mount gates, localStorage seeding, a debounce, an
    //       IntersectionObserver fallback
    //    2  signal-driven (a parent ticks a counter, we act)
    //
    // The first group is what effects are *for* — the rule's own help
    // text says "use an effect only when synchronizing with an external
    // system", which a file-read API is. The dialog resets have a
    // documented alternative (remount via `key`), but that is a change
    // to every call site, not to the effect.
    //
    // 43 inline suppressions would bury a future real one just as
    // thoroughly as this does, and in 25 files instead of here.
    "react/set-state-in-effect": "error",
    "react/refs": "warn",
    "react/purity": "warn",
    "react/immutability": "warn",
    "react/incompatible-library": "warn",
    "react/exhaustive-effect-dependencies": "warn",
    "react/hooks": "warn",
    "eslint/no-unsafe-optional-chaining": "warn"
  },

  "ignorePatterns": ["dist/**", "dist-web/**", "wailsjs/**", "node_modules/**"]
}
